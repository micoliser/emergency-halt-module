# Backend (Django indexer) — copy to .env and fill in.
# Never commit real secrets.

DJANGO_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
# DEBUG=True is for local development only. Deployed environments must use False.
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000
# Only needed behind a proxy that terminates TLS (Render, etc.)
# CSRF_TRUSTED_ORIGINS=https://your-api.onrender.com

DATABASE_URL=postgres://user:password@localhost:5432/emergency_halt
# Local: no password required. Production: do NOT expose Redis on the public
# internet; use AUTH (and TLS where available), e.g.
#   redis://:GENERATE_A_LONG_RANDOM_SECRET@redis-host:6379/0
#   rediss://:GENERATE_A_LONG_RANDOM_SECRET@redis-host:6379/0
REDIS_URL=redis://localhost:6379/0
# Optional overrides; both default to REDIS_URL
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Studionet only — see docs/architecture.md
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
HALT_MODULE_ADDRESS=
DEMO_VAULT_ADDRESS=

# `from` address on read-only gen_call requests. Reads need no funds.
GENLAYER_READER_ADDRESS=0x1111111111111111111111111111111111111111
GENLAYER_RPC_TIMEOUT=30
# Throttle between RPC calls to avoid studionet rate limits (-32006 / 429)
GENLAYER_RPC_THROTTLE_SECONDS=0.25
GENLAYER_RPC_MAX_RETRIES=3

# Protects POST /api/sync/protocols/:id and POST /api/sync/all.
# REQUIRED when DEBUG=False (Django refuses to start without it).
# Empty is allowed only with DEBUG=True (local). Send as X-Sync-Secret header
# only — query string is rejected.
SYNC_SHARED_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Celery beat cadence for the poll-and-diff indexer
SYNC_POLL_INTERVAL_SECONDS=300
# Page size used when reading list_* views (capped at API_MAX_PAGE_SIZE)
SYNC_PAGE_LIMIT=50

API_DEFAULT_PAGE_SIZE=20
# Keep in sync with the contract's MAX_PAGE_LIMIT
API_MAX_PAGE_SIZE=50

LOG_LEVEL=INFO

# Production only
# DB_SSL_REQUIRE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
